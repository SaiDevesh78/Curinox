# Copy this file to .env and fill in your real values.
# .env is gitignored - never commit real credentials.

# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database names (defaults shown match the code's fallback values)
MONGODB_DATABASE=Curinox_Centeral_DB
MEDICINE_DATABASE=Curionix

# Optional: enables the Gemini vision fallback for expiry-date detection
# when local OCR can't find a date. Leave blank to disable the fallback.
GEMINI_API_KEY=
